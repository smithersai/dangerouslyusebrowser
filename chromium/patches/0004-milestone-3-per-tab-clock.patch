+WebLocalFrame::DubClockResult WebLocalFrameImpl::ControlDubClock(
+    const WebString& op,
+    int64_t epoch_ms,
+    int64_t delta_ms,
+    uint32_t frames) {
+  DubClockResult out;
+  if (!GetFrame() || !GetFrame()->GetPage() ||
+      !GetFrame()->GetPage()->GetDubClock()) {
+    out.ok = false;
+    out.error_code = WebString::FromUtf8("PAGE_GONE");
+    out.error_message = WebString::FromUtf8("Page clock is unavailable");
+    return out;
+  }
+  DubPageClock* clock = GetFrame()->GetPage()->GetDubClock();
+  const std::string op_str = op.Utf8();
+  DubClockSnapshot snap;
+  if (op_str == "freeze") {
+    snap = clock->Freeze(epoch_ms);
+  } else if (op_str == "advance") {
+    snap = clock->Advance(delta_ms);
+  } else if (op_str == "step") {
+    snap = clock->StepFrames(frames);
+  } else if (op_str == "resume") {
+    snap = clock->Resume();
+  } else {
+    snap.ok = false;
+    snap.error_code = "INVALID_PARAMS";
+    snap.error_message = "Unknown clock op: " + op_str;
+  }
+  out.ok = snap.ok;
+  out.frozen = snap.frozen;
+  out.epoch_ms = snap.epoch_ms;
+  out.performance_now_ms = snap.performance_now_ms;
+  out.timers_fired = snap.timers_fired;
+  out.timers_capped = snap.timers_capped;
+  out.frames_stepped = snap.frames_stepped;
+  out.error_code = WebString::FromUtf8(snap.error_code);
+  out.error_message = WebString::FromUtf8(snap.error_message);
+  return out;
+}
