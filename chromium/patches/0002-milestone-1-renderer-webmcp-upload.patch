+std::vector<WebScriptToolDeclaration> WebDocument::ListScriptTools() const {
+  std::vector<WebScriptToolDeclaration> result;
+  const Document* document = ConstUnwrap<Document>();
+  if (!document) {
+    return result;
+  }
+  auto* model_context =
+      ModelContextSupplement::modelContext(*const_cast<Document*>(document));
+  if (!model_context) {
+    return result;
+  }
+  for (const ToolData* tool_data : model_context->ListTools()) {
+    const auto& tool = tool_data->ScriptTool();
+    WebScriptToolDeclaration decl;
+    decl.name = WebString(tool.name);
+    decl.title = tool.title ? WebString(tool.title) : WebString();
+    decl.description = WebString(tool.description);
+    decl.input_schema =
+        tool.input_schema ? WebString(tool.input_schema) : WebString();
+    if (tool.annotations) {
+      decl.read_only = tool.annotations->read_only;
+      decl.untrusted_content = tool.annotations->untrusted_content;
+      decl.consequential = tool.annotations->consequential;
+      decl.debugging = tool.annotations->debugging;
+    }
+    result.push_back(std::move(decl));
+  }
+  return result;
+}
