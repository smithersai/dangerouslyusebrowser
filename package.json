{
  "name": "dangerouslyusebrowser",
  "version": "0.1.0-alpha.1",
  "description": "Dub: Chromium internals, exposed to agents through native N-API bindings and incur MCP",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "dub": "bin/dub.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "native",
    "prebuilds",
    "scripts/build-native.mjs",
    "scripts/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node scripts/install.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "dev": "npm run build && node bin/dub.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@smthrs/harness": "^1.0.0-rc.18",
    "@smthrs/model": "^1.0.0-rc.18",
    "effect": "^4.1.1",
    "incur": "0.5.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
